@page "/Productos"
@rendermode InteractiveServer

<h3>Productos</h3>

@if (mensajeError != "")
{
    <div class="alert alert-danger" role="alert">
        @mensajeError
    </div>
}

<div class="row mb-3">
    <div class="col-md-6">
        <div class="mb-2">
            <label class="form-label" for="txtInventario">Inventario:</label>
            <input type="number" id="txtInventario" class="form-control" @bind="inventario" />
        </div>
        <div class="mb-2">
            <label class="form-label" for="txtNombre">Nombre:</label>
            <input type="text" id="txtNombre" class="form-control" @bind="nombre" />
        </div>
        <div class="mb-3">
            <label class="form-label me-2">Departamento:</label>

            <input type="radio" name="dept" id="r1" checked="@(departamento == "Frutas")" @onchange="@(() => departamento = "Frutas")">
            <label for="r1" class="me-2">Frutas</label>

            <input type="radio" name="dept" id="r2" checked="@(departamento == "Verduras")" @onchange="@(() => departamento = "Verduras")">
            <label for="r2" class="me-2">Verduras</label>

            <input type="radio" name="dept" id="r3" checked="@(departamento == "Lácteos")" @onchange="@(() => departamento = "Lácteos")">
            <label for="r3">Lácteos</label>
        </div>
    </div>
</div>

<div class="mb-4">
    @if (modoEdicion == false)
    {
        <button class="btn btn-primary me-2" @onclick="Guardar">Guardar</button>
        <button class="btn btn-secondary" @onclick="CambiarVista">
            @(vistaExistencias ? "Listado" : "Existencias")
        </button>
    }
    else
    {
        <button class="btn btn-primary me-2" @onclick="Actualizar">Actualizar</button>
        <button class="btn btn-danger" @onclick="Cancelar">Cancelar</button>
    }
</div>

@if (vistaExistencias == false)
{
    <p class="text-muted">Listado de productos</p>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Inventario</th>
                <th>Nombre</th>
                <th>Departamento</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < listaInventarios.Count; i++)
            {
                // Guardamos el índice actual para los botones
                int indiceActual = i;

                <tr>
                    <td>@listaInventarios[i]</td>
                    <td>@listaNombres[i]</td>
                    <td>@listaDepartamentos[i]</td>
                    <td>
                        <button class="btn btn-sm btn-danger me-1" @onclick="() => Eliminar(indiceActual)">Eliminar</button>
                        <button class="btn btn-sm btn-dark" @onclick="() => Editar(indiceActual)">Editar</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    // Calculamos las existencias antes de mostrar la tabla
    int totalFrutas = 0;
    int totalVerduras = 0;
    int totalLacteos = 0;

    for (int i = 0; i < listaDepartamentos.Count; i++)
    {
        if (listaDepartamentos[i] == "Frutas") totalFrutas++;
        if (listaDepartamentos[i] == "Verduras") totalVerduras++;
        if (listaDepartamentos[i] == "Lácteos") totalLacteos++;
    }

    <p class="text-muted">Existencias por departamento</p>
    <table class="table table-bordered text-center">
        <thead>
            <tr>
                <th>Frutas</th>
                <th>Verduras</th>
                <th>Lácteos</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>@totalFrutas</td>
                <td>@totalVerduras</td>
                <td>@totalLacteos</td>
            </tr>
        </tbody>
    </table>
}

@code {
    // LISTAS PARALELAS (en lugar de usar una clase)
    private List<int> listaInventarios = new();
    private List<string> listaNombres = new();
    private List<string> listaDepartamentos = new();

    // Variables de las cajas de texto (inputs)
    private int inventario = 0;
    private string nombre = "";
    private string departamento = "Frutas"; // Por defecto

    // Variables para controlar lo que se ve en pantalla
    private string mensajeError = "";
    private bool modoEdicion = false;
    private int indiceEditando = -1;
    private bool vistaExistencias = false;

    private void Guardar()
    {
        mensajeError = "";

        // Validar que no falten datos
        if (inventario <= 0 || nombre == "")
        {
            mensajeError = "Datos incorrectos. El inventario debe ser mayor a cero y debe tener nombre.";
            return;
        }

        // Buscar si el inventario ya existe usando un ciclo for
        bool existe = false;
        for (int i = 0; i < listaInventarios.Count; i++)
        {
            if (listaInventarios[i] == inventario)
            {
                existe = true;
            }
        }

        if (existe == true)
        {
            mensajeError = "El número de inventario se encuentra registrado. Debe ser único.";
        }
        else
        {
            // Agregar a las 3 listas al mismo tiempo
            listaInventarios.Add(inventario);
            listaNombres.Add(nombre);
            listaDepartamentos.Add(departamento);

            LimpiarCajas();
        }
    }

    private void Eliminar(int indice)
    {
        // Borramos el elemento de las 3 listas usando la misma posición (índice)
        listaInventarios.RemoveAt(indice);
        listaNombres.RemoveAt(indice);
        listaDepartamentos.RemoveAt(indice);
    }

    private void Editar(int indice)
    {
        modoEdicion = true;
        indiceEditando = indice;

        // Pasar los datos de la lista a las cajas de texto
        inventario = listaInventarios[indice];
        nombre = listaNombres[indice];
        departamento = listaDepartamentos[indice];

        mensajeError = "";
    }

    private void Actualizar()
    {
        mensajeError = "";

        if (inventario <= 0 || nombre == "")
        {
            mensajeError = "Datos incorrectos.";
            return;
        }

        // Validar que el nuevo número no lo tenga ya otro producto
        bool existe = false;
        for (int i = 0; i < listaInventarios.Count; i++)
        {
            // Si el inventario es igual a uno de la lista, pero NO es el que estoy editando
            if (listaInventarios[i] == inventario && i != indiceEditando)
            {
                existe = true;
            }
        }

        if (existe == true)
        {
            mensajeError = "El número de inventario se encuentra registrado. Debe ser único.";
        }
        else
        {
            // Actualizar los datos en las 3 listas en la posición que estamos editando
            listaInventarios[indiceEditando] = inventario;
            listaNombres[indiceEditando] = nombre;
            listaDepartamentos[indiceEditando] = departamento;

            modoEdicion = false;
            LimpiarCajas();
        }
    }

    private void Cancelar()
    {
        modoEdicion = false;
        mensajeError = "";
        LimpiarCajas();
    }

    private void CambiarVista()
    {
        if (vistaExistencias == true)
        {
            vistaExistencias = false;
        }
        else
        {
            vistaExistencias = true;
        }
    }

    private void LimpiarCajas()
    {
        inventario = 0;
        nombre = "";
        departamento = "Frutas";
    }
}